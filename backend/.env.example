# Database
DATABASE_URL=postgresql://user:password@localhost:5432/grant_automation

# JWT
JWT_SECRET=your-secret-key-change-this

# APIs
CLAUDE_API_KEY=your-claude-api-key
GEMINI_API_KEY=your-gemini-api-key

# Server
PORT=4006
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# CORS & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (for Bull queue + optional Socket.IO adapter)
# Set REDIS_URL to enable async bulk job processing via Bull queue.
# Without it, bulk jobs process synchronously (fine for small orgs).
REDIS_URL=redis://localhost:6379

# Default user credentials (persistent auth — seeded in DB on first startup)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_EMAIL=owner@private
DEFAULT_USER_PASSWORD=change-this-in-production

# Auto-reapply
# Days before estimated next funding cycle that a rejected grant becomes eligible to reapply
REAPPLY_LEAD_DAYS=60
# How often the background scheduler checks for reapply candidates
REAPPLY_CHECK_INTERVAL_HOURS=24

# Opportunity discovery
# Automatic periodic discovery is OFF by default — it spends Claude tokens on a
# timer. Set to true only if you want unattended scanning.
AUTO_DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_HOURS=24
# Minimum days before a deadline for an opportunity to be worth surfacing
MATCH_MIN_LEAD_DAYS=10
# How many opportunities get AI-scored per run — the main cost dial
MATCH_MAX_SCORED=15

# IRS 990 grantmaker lookup (ProPublica Nonprofit Explorer — free, no key)
# Finds foundations in your state that actually paid grants, from tax filings.
PROPUBLICA_LIMIT=20

# Daily inbox scan for funder responses (read-only IMAP, opt-in)
# Use an app-specific password, never your main account password.
EMAIL_SCAN_ENABLED=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_PORT=993
EMAIL_SCAN_LOOKBACK_DAYS=7
EMAIL_SCAN_INTERVAL_HOURS=24

# Claude model for long-form writing (business plan builder, funder tailoring,
# loan packets). Older features keep their own model setting in claudeService.
CLAUDE_WRITER_MODEL=claude-opus-5-5
# Let the business plan builder search the web for local market facts
CLAUDE_WEB_RESEARCH=true

# Google (Gmail drafts/sending + inbox scan, Calendar deadlines, Drive copies)
# Create an OAuth client (type "Web application") at console.cloud.google.com,
# enable the Gmail, Google Calendar and Google Drive APIs, and add the redirect
# URI below to the client. While the app is in "Testing", add your own Google
# account as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4006/api/google/callback
# Where to send the browser after connecting (defaults to the first ALLOWED_ORIGINS entry)
FRONTEND_URL=http://localhost:5173
# Used to encrypt stored Google tokens (falls back to JWT_SECRET)
TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_FOLDER_NAME=Grant & Loan Applications
# Public base URL of this API, used in calendar subscription links
PUBLIC_API_URL=http://localhost:4006

# Automation runner: discovery, drafting, reapply, Google sync, inbox scan and a
# digest email, on a timer. Each org also switches it on in Settings.
AUTOMATION_ENABLED=false
AUTOMATION_INTERVAL_HOURS=24
