# Database
DATABASE_URL=postgresql://user:password@localhost:5432/grant_automation

# JWT
JWT_SECRET=your-secret-key-change-this

# APIs
CLAUDE_API_KEY=your-claude-api-key
GEMINI_API_KEY=your-gemini-api-key

# Server
PORT=4006
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# CORS & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (for Bull queue + optional Socket.IO adapter)
# Set REDIS_URL to enable async bulk job processing via Bull queue.
# Without it, bulk jobs process synchronously (fine for small orgs).
REDIS_URL=redis://localhost:6379

# Default user credentials (persistent auth — seeded in DB on first startup)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_EMAIL=owner@private
DEFAULT_USER_PASSWORD=change-this-in-production

# Auto-reapply
# Days before estimated next funding cycle that a rejected grant becomes eligible to reapply
REAPPLY_LEAD_DAYS=60
# How often the background scheduler checks for reapply candidates
REAPPLY_CHECK_INTERVAL_HOURS=24

# Opportunity discovery
# Automatic periodic discovery is OFF by default — it spends Claude tokens on a
# timer. Set to true only if you want unattended scanning.
AUTO_DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_HOURS=24
# Minimum days before a deadline for an opportunity to be worth surfacing
MATCH_MIN_LEAD_DAYS=10
# How many opportunities get AI-scored per run — the main cost dial
MATCH_MAX_SCORED=15
