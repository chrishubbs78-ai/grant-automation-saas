# ---- Supabase (app + workers) ----------------------------------------------
# From supabase.com dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # server/workers only, never NEXT_PUBLIC

# ---- Worker auth -------------------------------------------------------------
# Random string shared between the app and all workers:
#   openssl rand -hex 32
WORKER_SHARED_SECRET=

# ---- Modal worker endpoints ---------------------------------------------------
# Printed by `modal deploy` for each worker's `trigger` endpoint, e.g.
# https://yourname--syncstage-analyze-trigger.modal.run
MODAL_ANALYZE_URL=
MODAL_AVATAR_URL=

# ---- Cost controls (optional; defaults shown) -----------------------------------
MAX_ACTIVE_JOBS_PER_USER=5
RENDER_MONTHLY_LIMIT=20

# ---- Render worker -------------------------------------------------------------
# URL of workers/render/server.mjs, e.g. https://syncstage-render.fly.dev/render
RENDER_WORKER_URL=
